# 复制为 .env 后填写。默认 mock + 离线 fixture，无需任何 Key 即可跑通演示。

# ---- LLM（OpenAI 兼容接口）----
# provider 可选：openai / deepseek / qwen / moonshot / zhipu / mock
INSIGHT_PROVIDER=deepseek
INSIGHT_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
# 智谱（GLM）
# INSIGHT_PROVIDER=zhipu
# INSIGHT_MODEL=glm-4.6
# ZHIPU_API_KEY=
# 同上：ZHIPU_API_KEY 也用于默认的 GLM embedding-3 向量化
# 如需改用其他 OpenAI 兼容端点，可在 config/settings.yaml 配置
# rag.embedding_base_url / rag.embedding_api_key_env
# 也可直接指定任意 OpenAI 兼容网关
# INSIGHT_BASE_URL=https://your-gateway/v1
# INSIGHT_API_KEY_ENV=OPENAI_API_KEY
# OPENAI_API_KEY=

# ---- 联网检索（可选）----
TAVILY_API_KEY=
